ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v2
# «нэр», «ярих» горим: цагт хэдэн ElevenLabs дуудлага (3 сек тутам). Хэтэрвэл Whisper руу шилжинэ.
ELEVENLABS_STT_PER_HOUR=300
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Дуу, яриа таних. Ерийн small/tiny монгол яриаг бараг танихгүй: training/whisper/convert_ct2.py-аар
# хөрвүүлсэн монгол загварын замыг (эсвэл HF Hub-ийн нэрийг) өгнө. Жишээ: ../training/whisper/data/whisper-small-mn-8-ct2
WHISPER_MODEL=small
SOUND_MIN_SCORE=0.3
# Хоосон бол YAMNet-ийн LABEL_MAP. training/sound/data/sound_head.json-ийн замыг өгвөл MLP толгой.
SOUND_HEAD_MODEL=
